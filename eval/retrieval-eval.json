    {"id": "e06", "query": "401 after redirect redirectUri", "expectedQuestionIds": ["1003"], "kind": "natural language"},
    {"id": "e07", "query": "map csv columns to dataset manifest.yaml", "expectedQuestionIds": ["1004"], "kind": "natural language"},
    {"id": "e08", "query": "helm upgrade --install orbit values.yaml", "expectedQuestionIds": ["1006"], "kind": "command"},
