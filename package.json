{
  "name": "questioncrawler",
  "private": true,
  "type": "module",
  "description": "Internal Q&A knowledge assistant. One command builds and starts backend and frontend.",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "start:prod": "node scripts/launch.cjs --prod",
    "test": "node scripts/launch.cjs --test",
    "check": "node scripts/launch.cjs --check",
    "backend": "node scripts/launch.cjs --backend-only",
    "build:backend": "node scripts/launch.cjs --compile"
  },
  "engines": {
    "node": ">=20"
  }
}
